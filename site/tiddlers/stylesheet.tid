title: $:/folio/stylesheet
tags: $:/tags/Stylesheet

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

:root {
	--bg: #f4efe4;
	--paper: #fbf8f1;
	--ink: #1b2330;
	--muted: #566070;
	--line: #ddd3c0;
	--line-strong: #c9bda5;
	--accent: #a2401d;
	--accent-ink: #ffffff;
	--accent-2: #1d6560;
	--band: #17212e;
	--band-ink: #f1ece0;
	--band-muted: #b4bdca;
	--band-line: #2f3c4f;
	--band-accent: #f0a07a;
	--shadow: 0 1px 0 rgba(27,35,48,.04), 0 18px 40px -22px rgba(27,35,48,.35);
	--display-font: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
	--sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
	--mono: ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
	--display: clamp(3.3rem, 9.5vw, 7.4rem);
	--h-xl: clamp(2.5rem, 5.8vw, 4.6rem);
	--h-lg: clamp(2.1rem, 4.2vw, 3.2rem);
	--lead: clamp(1.2rem, 2.2vw, 1.55rem);
	--gutter: clamp(1.25rem, 5vw, 3.5rem);
	color-scheme: light dark;
}

@media (prefers-color-scheme: dark) {
	:root {
		--bg: #10161e;
		--paper: #18202b;
		--ink: #ece6d8;
		--muted: #a4aebb;
		--line: #28323f;
		--line-strong: #3b4759;
		--accent: #ee8a5e;
		--accent-ink: #10161e;
		--accent-2: #6cc0b6;
		--band: #0a0f15;
		--band-line: #243040;
		--shadow: 0 1px 0 rgba(0,0,0,.3), 0 18px 40px -22px rgba(0,0,0,.8);
	}
}

*, *::before, *::after { box-sizing: border-box; }

html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

body {
	margin: 0;
	background: var(--bg);
	color: var(--ink);
	font: 400 1.0625rem/1.65 var(--sans);
	-webkit-font-smoothing: antialiased;
	text-rendering: optimizeLegibility;
}

a { color: inherit; }
img { max-width: 100%; }
h1, h2, h3, p, blockquote, figure, ul, ol, dl { margin-top: 0; }

:focus-visible {
	outline: 3px solid var(--accent-2);
	outline-offset: 3px;
	border-radius: 4px;
}
main:focus { outline: none; }

.skip-link {
	position: absolute;
	left: 1rem;
	top: -4rem;
	z-index: 100;
	background: var(--ink);
	color: var(--bg);
	padding: .6rem 1rem;
	border-radius: 8px;
}
.skip-link:focus { top: 1rem; }

.sr-only {
	position: absolute; width: 1px; height: 1px; overflow: hidden;
	clip: rect(0 0 0 0); white-space: nowrap;
}

/* ---------- header ---------- */

.site-head {
	position: sticky; top: 0; z-index: 50;
	background: color-mix(in srgb, var(--bg) 86%, transparent);
	-webkit-backdrop-filter: blur(12px);
	backdrop-filter: blur(12px);
	border-bottom: 1px solid var(--line);
}
.head-in {
	max-width: 1240px; margin: 0 auto;
	padding: .7rem var(--gutter);
	display: flex; align-items: center; gap: 1.2rem;
}
.brand {
	display: inline-flex; align-items: center; gap: .65rem;
	text-decoration: none; flex: none;
}
.brand img { width: 34px; height: 34px; display: block; border-radius: 9px; }
.brand-name { font-family: var(--display-font); font-size: 1.15rem; font-weight: 600; letter-spacing: -.01em; }

.site-nav {
	margin-left: auto; display: flex; gap: .2rem;
	overflow-x: auto; scrollbar-width: none;
}
.site-nav::-webkit-scrollbar { display: none; }
.nav-link {
	padding: .5rem .9rem; border-radius: 999px;
	font-size: .93rem; font-weight: 500; color: var(--muted);
	text-decoration: none; white-space: nowrap;
	transition: background .18s, color .18s;
}
.nav-link:hover { background: var(--line); color: var(--ink); }
.nav-link.is-active { background: var(--ink); color: var(--bg); }

/* ---------- shared pieces ---------- */

.wrap { max-width: 1240px; margin-inline: auto; padding-inline: var(--gutter); }

.project, .page-head, .workshop { scroll-margin-top: 4.5rem; }
.view { min-height: 70vh; padding-bottom: 3rem; display: flow-root; }

@media (prefers-reduced-motion: no-preference) {
	.view > * { animation: rise .55s cubic-bezier(.2,.7,.2,1) both; }
	.view > *:nth-child(2) { animation-delay: .06s; }
	.view > *:nth-child(3) { animation-delay: .12s; }
	.view > *:nth-child(4) { animation-delay: .18s; }
	@keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
}

.eyebrow {
	font: 600 .78rem/1.3 var(--mono);
	letter-spacing: .14em; text-transform: uppercase;
	color: var(--accent); margin-bottom: .6rem;
}

.display {
	font-family: var(--display-font); font-weight: 600;
	font-size: var(--display); line-height: .94; letter-spacing: -.035em;
	margin: .15em 0 .25em;
}
.h-xl {
	font-family: var(--display-font); font-weight: 600;
	font-size: var(--h-xl); line-height: 1.02; letter-spacing: -.025em;
	margin: .1em 0 .35em; max-width: 18ch;
}
.h-xl .soft { font-style: italic; font-weight: 400; color: var(--accent-2); }
.h-lg {
	font-family: var(--display-font); font-weight: 600;
	font-size: var(--h-lg); line-height: 1.05; letter-spacing: -.02em;
	margin: 0 0 .2em;
}
.subhead {
	font-family: var(--display-font); font-style: italic;
	font-size: clamp(1.2rem, 2.2vw, 1.5rem); color: var(--accent-2);
	margin-bottom: 1.6rem;
}
.lead { font-size: var(--lead); line-height: 1.4; max-width: 38ch; }

.btn {
	display: inline-flex; align-items: center; gap: .5rem;
	padding: .8rem 1.3rem; border-radius: 999px;
	background: var(--ink); color: var(--bg);
	font-weight: 600; font-size: .98rem; text-decoration: none;
	border: 1.5px solid var(--ink);
	transition: transform .18s, background .18s, color .18s;
}
.btn:hover { transform: translateY(-2px); }
.btn-ghost { background: transparent; color: var(--ink); }
.btn-ghost:hover { background: var(--ink); color: var(--bg); }
.cta, .links { display: flex; flex-wrap: wrap; gap: .7rem; }
.links { margin-top: 1.6rem; }

.chips { display: flex; flex-wrap: wrap; gap: .4rem; margin: .8rem 0 0; }
.chip {
	font: 500 .76rem/1 var(--mono);
	padding: .42rem .7rem; border-radius: 999px;
	border: 1px solid var(--line-strong); background: var(--paper); color: var(--muted);
}

.bignum {
	position: absolute; right: var(--gutter); top: -.35rem;
	font: 700 clamp(7rem, 22vw, 17rem)/1 var(--display-font);
	color: transparent; -webkit-text-stroke: 2px var(--line-strong);
	pointer-events: none; user-select: none; letter-spacing: -.05em;
}
.page-head { position: relative; padding-block: clamp(2.5rem, 6vw, 5rem) 1.5rem; }

/* ---------- home ---------- */

.hero {
	display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
	gap: clamp(1.5rem, 4vw, 4rem); align-items: center;
	padding-block: clamp(2.5rem, 7vw, 6rem) clamp(2rem, 5vw, 4rem);
}
.hero-role {
	font-family: var(--display-font); font-style: italic;
	font-size: clamp(1.35rem, 2.9vw, 2.05rem); line-height: 1.2;
	color: var(--accent); margin-bottom: 1.5rem; max-width: 24ch;
}
.hero-role .amp { font-style: italic; }
.hero .lead { margin-bottom: 2rem; }

.graph { width: 100%; max-width: 540px; height: auto; margin-inline: auto; display: block; overflow: visible; }
.g-edges line { stroke: var(--line-strong); stroke-width: 1.6; }
.g-edges .faint { stroke-dasharray: 4 6; opacity: .8; }
.g-node { cursor: pointer; text-decoration: none; }
.g-node circle { fill: var(--paper); stroke: var(--accent); stroke-width: 2.5; transition: fill .2s, transform .2s; transform-box: fill-box; transform-origin: center; }
.g-node:hover circle, .g-node:focus-visible circle { fill: var(--accent); transform: scale(1.12); }
.g-node:hover .g-num, .g-node:focus-visible .g-num { fill: var(--accent-ink); }
.g-sub circle { stroke: var(--accent-2); stroke-width: 2; }
.g-sub:hover circle, .g-sub:focus-visible circle { fill: var(--accent-2); }
.g-core circle { fill: var(--ink); stroke: none; }
.g-core text { fill: var(--bg); font: 700 20px var(--display-font); }
.g-num { font: 600 13px var(--mono); fill: var(--accent); pointer-events: none; }
.g-label { font: 600 16px var(--sans); fill: var(--ink); }
.g-sublabel { font: 500 13px var(--sans); fill: var(--muted); }
.g-dot { fill: var(--line-strong); }

.doors {
	display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
	gap: 1rem; padding-block: 1rem 2rem;
}
.door {
	position: relative; display: flex; flex-direction: column; gap: .6rem;
	min-height: 15rem; padding: 1.6rem 1.7rem;
	background: var(--paper); border: 1px solid var(--line); border-radius: 24px;
	text-decoration: none; box-shadow: var(--shadow);
	transition: transform .2s, border-color .2s;
}
.door:hover { transform: translateY(-3px); border-color: var(--accent); }
.door-a { grid-column: span 7; }
.door-b { grid-column: span 5; }
.door-c { grid-column: span 5; }
.door-d { grid-column: span 7; }
.door-d { background: var(--band); color: var(--band-ink); border-color: var(--band); }
.door-d .door-text { color: var(--band-muted); }
.door-d .door-num, .door-d .door-go { color: var(--band-accent); -webkit-text-stroke-color: var(--band-accent); }
.door-num {
	font: 700 3.8rem/1 var(--display-font); color: transparent;
	-webkit-text-stroke: 1.5px var(--accent); letter-spacing: -.03em;
}
.door-title { font-family: var(--display-font); font-size: clamp(1.5rem, 2.6vw, 2rem); line-height: 1.1; font-weight: 600; }
.door-text { color: var(--muted); max-width: 36ch; }
.door-go { margin-top: auto; font: 600 .78rem var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }

.quote-band {
	background: var(--band); color: var(--band-ink);
	padding-block: clamp(3rem, 8vw, 6.5rem); margin-top: clamp(2rem, 5vw, 4rem);
}
.quote-band blockquote { margin: 0; }
.quote-band blockquote p {
	font-family: var(--display-font); font-style: italic;
	font-size: clamp(1.8rem, 4.4vw, 3.3rem); line-height: 1.14; letter-spacing: -.015em; margin: 0; max-width: 22em;
}
.quote-band .attrib { margin-top: 1.4rem; font: 500 .85rem var(--mono); letter-spacing: .08em; color: var(--band-muted); }
.quote-band .attrib a { color: var(--band-accent); }

.site-note {
	display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: center;
	padding-block: clamp(2rem, 5vw, 3.5rem);
}
.site-note p { margin: 0; max-width: 56ch; font-size: 1.1rem; }
.site-note strong { font-family: var(--display-font); font-size: 1.5rem; display: block; margin-bottom: .3rem; }

/* ---------- projects ---------- */

.project {
	display: grid; grid-template-columns: minmax(0, .72fr) minmax(0, 1.6fr);
	gap: clamp(1.5rem, 4.5vw, 4.5rem);
	padding-block: clamp(2.2rem, 5vw, 4rem);
	border-top: 1px solid var(--line);
}
.project.flip { grid-template-columns: minmax(0, 1.6fr) minmax(0, .72fr); }
.project.flip .project-art { order: 2; }
.project-art { position: sticky; top: 5.5rem; align-self: start; }
.logo-tile { aspect-ratio: 1; border-radius: 30px; overflow: hidden; box-shadow: var(--shadow); background: var(--line); }
.logo-tile img { display: block; width: 100%; height: 100%; object-fit: cover; }
.tile-cap { font: 500 .8rem var(--mono); letter-spacing: .06em; color: var(--muted); margin: .9rem 0 0; }

.pull { margin: 0 0 1.8rem; padding-left: 1.3rem; border-left: 4px solid var(--accent); }
.pull .label { font: 600 .76rem var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--accent); margin-bottom: .2rem; }
.pull .pull-text { font-family: var(--display-font); font-size: clamp(1.3rem, 2.5vw, 1.85rem); line-height: 1.3; margin: 0; }

.rows { margin: 0; }
.row {
	display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: 1.2rem;
	padding-block: 1.05rem; border-top: 1px solid var(--line);
}
.row-label { font: 600 .76rem var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--accent-2); padding-top: .3rem; margin: 0; }
.row-text { margin: 0; }
.row-text a { color: var(--accent); text-underline-offset: 3px; }

.more { margin-top: 1.3rem; border: 1px solid var(--line); border-radius: 16px; background: var(--paper); }
.more summary { cursor: pointer; padding: .95rem 1.2rem; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
.more summary::-webkit-details-marker { display: none; }
.more summary::after { content: "+"; font: 400 1.4rem/1 var(--mono); color: var(--accent); }
.more[open] summary::after { content: "\2212"; }
.more ul { margin: 0; padding: 0 1.2rem 1.2rem 2.5rem; }
.more li { margin-bottom: .35rem; }
.more p { padding: 0 1.2rem 1.1rem; margin: 0; color: var(--muted); }

.shot {
	margin: 0 0 1rem; border-radius: 18px; overflow: hidden;
	border: 1px solid var(--line-strong); background: var(--paper); box-shadow: var(--shadow);
}
.shot-bar { display: flex; align-items: center; gap: .4rem; padding: .6rem .9rem; background: var(--line); font: 500 .75rem var(--mono); color: var(--muted); }
.shot-bar i { width: .65rem; height: .65rem; border-radius: 50%; background: var(--line-strong); display: inline-block; }
.shot-bar span { margin-left: .5rem; }
.shot img { display: block; width: 100%; height: auto; min-height: 8rem; }
.shot figcaption { padding: .75rem 1rem; font-size: .9rem; color: var(--muted); border-top: 1px solid var(--line); }
.shots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; padding-bottom: 1rem; }

.workshop { padding-block: clamp(2rem, 5vw, 3.5rem) 1rem; border-top: 1px solid var(--line); }
.workshop h2 { font-family: var(--display-font); font-size: clamp(1.5rem, 3vw, 2.1rem); margin: 0 0 1.2rem; }
.minis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
.mini { padding: 1.3rem; border-radius: 18px; border: 1px dashed var(--line-strong); }
.mini strong { display: block; font-family: var(--display-font); font-size: 1.25rem; margin-bottom: .3rem; }
.mini p { margin: 0; color: var(--muted); font-size: .98rem; }

/* ---------- institutional ---------- */

.flow {
	list-style: none; margin: 1rem 0 0; padding: 0;
	display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.1rem; counter-reset: step;
}
.flow li {
	position: relative; counter-increment: step;
	padding: 1.2rem 1.1rem 1.3rem; background: var(--paper);
	border: 1px solid var(--line); border-radius: 18px;
}
.flow li::before { content: counter(step, decimal-leading-zero); display: block; font: 600 .8rem var(--mono); color: var(--accent); margin-bottom: .5rem; }
.flow li:not(:last-child)::after { content: ""; position: absolute; right: -1.1rem; top: 50%; width: 1.1rem; border-top: 2px solid var(--line-strong); }
.flow strong { display: block; font-family: var(--display-font); font-size: 1.3rem; margin-bottom: .3rem; }
.flow span { color: var(--muted); font-size: .95rem; line-height: 1.45; display: block; }
.fine { margin-top: 1.4rem; padding: 1rem 1.2rem; border-left: 3px solid var(--accent-2); background: var(--paper); border-radius: 0 12px 12px 0; color: var(--muted); font-size: .96rem; }
.section-gap { padding-block: clamp(1.5rem, 4vw, 3rem) 0; }


.register { font: 600 .76rem var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin: .2rem 0 0; }
.register::before { content: ""; display: inline-block; width: .55rem; height: .55rem; border-radius: 50%; background: var(--accent-2); margin-right: .55rem; vertical-align: .05em; }
.page-head .lead + .register { margin-top: 1.1rem; }

.delivered { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-top: .6rem; }
.d-card { background: var(--paper); border: 1px solid var(--line); border-radius: 20px; padding: 1.3rem 1.3rem 1.4rem; display: flex; flex-direction: column; gap: .3rem; }
.d-num { font: 700 3.4rem/1 var(--display-font); color: var(--accent); letter-spacing: -.04em; }
.d-card strong { font-family: var(--display-font); font-size: 1.25rem; }
.d-card span:last-child { color: var(--muted); font-size: .95rem; line-height: 1.45; }

/* ---------- media ---------- */

.videos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; padding-block: 1.5rem 2.5rem; }
.video-card h3 { font-family: var(--display-font); font-size: 1.3rem; margin: .9rem 0 .2rem; }
.video-card p { margin: 0; color: var(--muted); font-size: .95rem; }
.video-card a { color: var(--accent); text-underline-offset: 3px; }
.video { aspect-ratio: 16 / 9; border-radius: 18px; overflow: hidden; background: #0b0f14; box-shadow: var(--shadow); }
.video iframe { width: 100%; height: 100%; border: 0; display: block; }

.trio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; padding-bottom: 1rem; }
.trio article { background: var(--paper); border: 1px solid var(--line); border-radius: 20px; padding: 1.5rem; }
.trio h3 { font: 600 .78rem var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--accent-2); margin-bottom: .6rem; }
.trio p { margin: 0; }
.trio a { color: var(--accent); text-underline-offset: 3px; }


/* ---------- video facade ---------- */

.facade {
	position: relative; display: flex; flex-direction: column; justify-content: flex-end; gap: .35rem;
	width: 100%; height: 100%; padding: 1.4rem 1.5rem; text-decoration: none; color: #f1ece0;
	background: radial-gradient(120% 120% at 85% 10%, #3a2250 0%, #151a24 55%, #0b0f14 100%);
}
.facade-play {
	position: absolute; left: 50%; top: 42%; width: 4.6rem; height: 4.6rem; margin: -2.3rem 0 0 -2.3rem;
	border-radius: 50%; background: #f0a07a; box-shadow: 0 0 0 10px rgba(240,160,122,.2);
	transition: transform .2s, box-shadow .2s;
}
.facade-play::after {
	content: ""; position: absolute; left: 1.75rem; top: 1.35rem;
	border-left: 1.45rem solid #17212e; border-top: .95rem solid transparent; border-bottom: .95rem solid transparent;
}
.facade:hover .facade-play, .facade:focus-visible .facade-play { transform: scale(1.08); box-shadow: 0 0 0 14px rgba(240,160,122,.28); }
.facade-title { font-family: var(--display-font); font-size: 1.25rem; line-height: 1.2; }
.facade-hint { font: 600 .74rem var(--mono); letter-spacing: .12em; text-transform: uppercase; color: #f0a07a; }
.facade-hint::before { content: "Play here"; }
.no-embed .facade-hint::before { content: "Opens on YouTube"; }
.facade-url { display: none; }

/* ---------- governance (dark band) ---------- */

.view-governance { background: var(--band); color: var(--band-ink); }
.view-governance .eyebrow { color: var(--band-accent); }
.view-governance .bignum { -webkit-text-stroke-color: var(--band-line); }
.view-governance .h-xl .soft { color: var(--band-accent); }
.view-governance .lead { color: var(--band-muted); }
.rubric { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.1rem; padding-block: 1rem 2rem; }
.rubric-card {
	position: relative; padding: 1.8rem 1.9rem 2rem;
	border: 1px solid var(--band-line); border-radius: 26px;
	background: rgba(255,255,255,.03);
}
.rubric-card:nth-child(1) { grid-column: span 7; }
.rubric-card:nth-child(2) { grid-column: span 5; }
.rubric-card:nth-child(3) { grid-column: span 5; }
.rubric-card:nth-child(4) { grid-column: span 7; }
.rubric-card .n { display: block; font: 700 4.4rem/1 var(--display-font); color: var(--band-accent); letter-spacing: -.04em; margin-bottom: .6rem; }
.rubric-card h3 { font-family: var(--display-font); font-size: clamp(1.5rem, 2.8vw, 2.1rem); line-height: 1.1; margin-bottom: .6rem; }
.rubric-card p { color: var(--band-muted); margin: 0; max-width: 46ch; }

.upstream-wrap { padding-bottom: 2rem; }
.upstream-title { font: 600 .78rem var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--band-accent); margin-bottom: 1rem; }
.upstream { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.2fr) auto minmax(0, 1fr); gap: 1rem; align-items: center; }
.u-box { padding: 1.1rem 1.2rem; border: 1px solid var(--band-line); border-radius: 16px; background: rgba(255,255,255,.04); font-weight: 600; text-align: center; }
.u-col { display: grid; gap: .6rem; }
.u-col .u-box { font-weight: 500; padding-block: .75rem; text-align: left; }
.u-fail { border-color: #d98a7a; }
.u-fix { background: var(--band-accent); color: #17212e; border-color: var(--band-accent); }
.u-arrow { font: 400 1.8rem var(--mono); color: var(--band-accent); }

/* ---------- about ---------- */

.about-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .9fr); gap: clamp(1.5rem, 5vw, 5rem); padding-block: 1rem 2rem; }
.about-grid p { max-width: 62ch; }
.about-grid h2, .how h2 { font-family: var(--display-font); font-size: 1.6rem; margin: 1.8rem 0 .5rem; }
.about-grid h2:first-child { margin-top: 0; }
.aside-card { background: var(--paper); border: 1px solid var(--line); border-radius: 22px; padding: 1.6rem; align-self: start; box-shadow: var(--shadow); }
.aside-card h2 { margin-top: 0; }
.aside-card ul { padding-left: 1.1rem; margin-bottom: 0; }
.aside-card li { margin-bottom: .5rem; }
.how { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; padding-bottom: 2rem; }
.how article { border: 1px solid var(--line); border-radius: 20px; padding: 1.5rem; background: var(--paper); }
.how h3 { font-family: var(--display-font); font-size: 1.3rem; margin-bottom: .4rem; }
.how p { margin: 0; color: var(--muted); }
.about-grid a, .how a { color: var(--accent); text-underline-offset: 3px; }

/* ---------- pager and footer ---------- */

.pager-in { display: flex; justify-content: space-between; gap: 1rem; padding-block: 2.5rem 1rem; }
.pager-link {
	flex: 1 1 0; max-width: 26rem; display: block;
	padding: 1.2rem 1.4rem; border: 1px solid var(--line-strong); border-radius: 20px;
	background: var(--paper); text-decoration: none;
	transition: transform .2s, border-color .2s;
}
.pager-link:hover { transform: translateY(-2px); border-color: var(--accent); }
.pager-next { margin-left: auto; text-align: right; }
.pager-dir { display: block; font: 600 .75rem var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
.pager-title { font-family: var(--display-font); font-size: 1.6rem; }
.pager-prev .pager-dir::before { content: "\2190  "; }
.pager-next .pager-dir::after { content: "  \2192"; }

.site-foot { border-top: 1px solid var(--line); margin-top: 2.5rem; padding-block: 1.8rem 2.5rem; color: var(--muted); font-size: .93rem; }
.foot-in { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .6rem 2rem; }
.foot-in p { margin: 0; }
.foot-in a { margin-left: 1.2rem; text-underline-offset: 3px; }
.foot-in a:first-child { margin-left: 0; }

/* ---------- small screens ---------- */

@media screen and (max-width: 900px) {
	.hero { grid-template-columns: 1fr; }
	.graph { max-width: 420px; }
	.door-a, .door-b, .door-c, .door-d { grid-column: 1 / -1; min-height: 12rem; }
	.project, .project.flip { grid-template-columns: 1fr; }
	.project.flip .project-art { order: 0; }
	.project-art { position: static; display: grid; grid-template-columns: 8.5rem 1fr; gap: 0 1.2rem; align-items: center; }
	.project-art .logo-tile { grid-row: span 3; }
	.project-art .tile-cap { margin: 0; }
	.project-art .chips { margin: .4rem 0 0; }
	.shots, .videos, .minis, .trio, .how, .about-grid { grid-template-columns: 1fr; }
	.delivered { grid-template-columns: 1fr 1fr; }
	.flow { grid-template-columns: 1fr; }
	.flow li:not(:last-child)::after { right: auto; left: 2rem; top: auto; bottom: -1.1rem; width: 0; height: 1.1rem; border-top: 0; border-left: 2px solid var(--line-strong); }
	.rubric-card:nth-child(n) { grid-column: 1 / -1; }
	.upstream { grid-template-columns: 1fr; }
	.u-arrow { transform: rotate(90deg); text-align: center; }
	.site-note { grid-template-columns: 1fr; gap: 1rem; }
}

@media screen and (max-width: 640px) {
	.head-in { flex-wrap: wrap; row-gap: .4rem; }
	.site-nav { margin-left: 0; width: 100%; }
	.row { grid-template-columns: 1fr; gap: .2rem; }
	.pager-in { flex-direction: column; }
	.pager-link { max-width: none; width: 100%; }
	.pager-next { margin-left: 0; }
	.bignum { opacity: .6; }
	.project-art { grid-template-columns: 6.5rem 1fr; }
}

/* ---------- print and PDF ---------- */

.print-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.2rem; border-bottom: 1px solid var(--line); }
.print-bar p { margin: 0; color: var(--muted); }
.print-section + .print-section { border-top: 1px solid var(--line); margin-top: 2rem; }
.print-end { display: none; }

@page { size: Letter; margin: 12mm 13mm; }

@media print {
	:root {
		--bg: #ffffff; --paper: #ffffff; --ink: #1b2330; --muted: #444d5c;
		--line: #d8d2c4; --line-strong: #bdb5a2; --accent: #8f3517; --accent-2: #1d6560;
		--band: #ffffff; --band-ink: #1b2330; --band-muted: #444d5c; --band-line: #bdb5a2; --band-accent: #8f3517;
		--shadow: none;
		--display: 3rem; --h-xl: 2.1rem; --h-lg: 1.6rem; --lead: 1.02rem; --gutter: 0;
	}
	html { scroll-behavior: auto; }
	body { font-size: 9.5pt; line-height: 1.42; -webkit-print-color-adjust: exact; print-color-adjust: exact; }

	/* one page per section: Overview, Systems, Institutional, Media, Governance */
	.print-section { break-before: page; break-inside: avoid; margin: 0; border: 0; overflow: hidden; }
	.print-home { break-before: auto; }
	.print-end { display: block; margin: 0; padding-top: 3mm; font-size: 8.5pt; color: var(--muted); border-top: 1px solid var(--line); }

	/* things that only make sense on screen */
	.site-head, .pager, .skip-link, .print-bar, .site-foot, .bignum, .cta, .links, .site-note,
	.more, .shot, .shots, .workshop, .flow li::after { display: none !important; }
	.view > * { animation: none !important; }
	.view { min-height: 0; padding-bottom: 0; }
	.wrap { max-width: none; padding-inline: 0; }
	.view > .wrap, .view > section, .view > header, .view > article { margin-inline: 0; }
	a { text-decoration: none; color: inherit; }
	h1, h2, h3, .eyebrow, .subhead { break-after: avoid; }

	/* overview */
	.hero { grid-template-columns: 1.15fr .85fr; padding-block: 0 5mm; gap: 8mm; }
	.hero-role { margin-bottom: .8rem; }
	.hero .lead { margin-bottom: 0; }
	.graph { max-width: 280px; }
	.doors { padding-block: 0; gap: 4mm; }
	.door { min-height: 0; padding: 4mm 5mm; border-radius: 12px; box-shadow: none; }
	.door-num { font-size: 2rem; }
	.door-title { font-size: 1.25rem; }
	.door-go { display: none; }
	.door-d, .door-d .door-text { background: none; color: var(--ink); border-color: var(--line); }
	.door-d .door-num { color: transparent; -webkit-text-stroke-color: var(--accent); }
	.quote-band { background: none; color: var(--ink); padding-block: 5mm 0; margin-top: 5mm; }
	.quote-band blockquote p { font-size: 1.45rem; border-left: 3px solid var(--accent); padding-left: 5mm; }
	.quote-band .attrib { display: none; }

	/* shared */
	.page-head { padding-block: 0 3mm; }
	.page-head .lead { margin-bottom: 0; }
	.project, .project.flip { grid-template-columns: 24mm 1fr; gap: 6mm; padding-block: 3.5mm; }
	.project.flip .project-art { order: 0; }
	.project-art { position: static; }
	.logo-tile { border-radius: 10px; box-shadow: none; border: 1px solid var(--line); }
	.tile-cap, .chips { display: none; }
	.pull { margin-bottom: 2.5mm; }
	.pull .pull-text { font-size: 1.1rem; }
	.subhead { margin-bottom: .6rem; font-size: 1.05rem; }
	.row { padding-block: 1.6mm; gap: 4mm; grid-template-columns: 26mm 1fr; }
	.row-label { font-size: .66rem; padding-top: .1rem; }
	.section-gap { padding-block: 4mm 0; }
	.fine { margin-top: 3mm; padding: 2mm 3mm; }

	/* institutional */
	.screen-only { display: none !important; }
	.print-institutional { zoom: .9; }
  .print-institutional .d-card > span:not(.d-num) { display:none; }
  .print-institutional .page-head { padding-top:0 !important; padding-bottom:2mm !important; }
  .print-institutional .section-gap { margin-top:3mm !important; }
  .print-institutional .logo-tile { width:22mm !important; height:22mm !important; }
  .print-institutional .tile-cap, .print-institutional .chips, .print-institutional .subhead { display:none; }
	.practice .rows { display: grid; grid-template-columns: 1fr 1fr; column-gap: 6mm; }
	.practice .row { grid-template-columns: 22mm 1fr; }
	.flow { grid-template-columns: repeat(5, 1fr); gap: 2.5mm; margin-top: 2mm; }
	.flow li { padding: 2.5mm 3mm; border-radius: 8px; }
	.flow strong { font-size: 1rem; }
	.flow span { font-size: .8rem; line-height: 1.3; }
	.delivered { gap: 2.5mm; margin-top: 2mm; }
	.d-card { padding: 2.5mm 3mm; border-radius: 8px; }
	.d-num { font-size: 1.9rem; }
	.d-card strong { font-size: 1rem; }
	.d-card span:last-child { font-size: .8rem; line-height: 1.3; }
	#puppetstudio { margin-top: 3mm !important; }

	/* media */
	.videos { grid-template-columns: 1fr 1fr; gap: 6mm; padding-block: 3mm; }
	.video { aspect-ratio: 16 / 6; border-radius: 8px; box-shadow: none; border: 1px solid var(--line-strong); }
	.facade { background: #f2eee4; color: var(--ink); justify-content: center; align-items: flex-start; padding: 4mm; }
	.facade-play, .facade-hint { display: none; }
	.facade-title { font-size: 1rem; }
	.facade-url { display: block; font: 500 .72rem var(--mono); color: var(--accent); }
	.video-card h3 { margin-top: 2mm; font-size: 1.05rem; }
	.trio { gap: 3mm; }
	.trio article { padding: 3.5mm 4mm; border-radius: 10px; }

	/* governance */
	.view-governance { background: none; color: var(--ink); }
	.rubric { gap: 3.5mm; padding-block: 2mm 4mm; }
	.rubric-card { background: none; padding: 4.5mm 5mm; border-radius: 12px; }
	.rubric-card .n { font-size: 2.2rem; margin-bottom: .2rem; }
	.rubric-card h3 { font-size: 1.25rem; }
	.u-box { background: none; padding: 3mm 4mm; }
	.u-col .u-box { padding-block: 2mm; }
	.u-fix { background: #f0a07a; color: #17212e; border-color: #f0a07a; }
	.upstream-wrap { padding-bottom: 0; }
}
